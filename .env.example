# URL of the Myna site used for browser login, tokens, and model discovery.
# In local development this defaults to https://huabot.com when omitted.
VITE_MYNA_BASE_URL=https://huabot.com
# Registered Myna OAuth public-client ID used for device authorization.
VITE_MYNA_OAUTH_CLIENT_ID=7TFTirm5DQMSy0ENT8Lxjm0I4T6Gm9YW
# OpenAI-compatible Myna API base URL used by the VoiceChat server.
OPENAI_BASE_URL=https://huabot.com/v1
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
OPENAI_AUDIO_MODEL=gpt-audio-mini
OPENAI_REQUEST_TIMEOUT_MS=30000
# Enable trusted server-side Brave MCP search. Browser clients never receive these values.
WEB_SEARCH_ENABLED=false
BRAVE_MCP_SERVER_URL=
BRAVE_MCP_AUTHORIZATION_HEADER=Authorization
BRAVE_MCP_AUTHORIZATION=
# Comma-separated exact MCP tool names supplied by the configured Brave server.
BRAVE_MCP_ALLOWED_TOOLS=
MCP_TOOL_TIMEOUT_MS=10000
# gpt-audio-mini streams PCM16 at 24 kHz; the server wraps it as WAV for browsers.
PORT=8787
